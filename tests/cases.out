[exit 0]
$ resid-cmw diag tree.cmw
{
  "e": ["application/octet-stream", h'', 3],
  "z": ["application/octet-stream", h'010203'],
  "outer": {
    "__cmwc_t": "tag:example.com,2026:demo",
    "ev": ["application/eat+cbor", h'68656c6c6f', 4],
    "raw": ["application/octet-stream", h'010203']
  }
}
[exit 0]
$ resid-cmw check ev.cmw tree.cmw
ev.cmw: ok
tree.cmw: ok
[exit 0]
## extracting
$ resid-cmw extract tree.cmw outer/ev --value
hello[exit 0]
$ resid-cmw extract tree.cmw /outer/ev -o ev2.cmw
[exit 0]
$ cmp ev.cmw ev2.cmw
[exit 0]
$ resid-cmw extract tree.cmw / -o tree2.cmw
[exit 0]
$ cmp tree.cmw tree2.cmw
[exit 0]
$ resid-cmw extract tree.cmw outer --value
resid-cmw: "outer" is a collection; --value needs a record
[exit 1]
$ resid-cmw extract tree.cmw z/q
resid-cmw: "z" is a record, not a collection
[exit 1]
$ resid-cmw extract tree.cmw nope
resid-cmw: no member "nope" in the root
[exit 1]
$ resid-cmw extract tree.cmw outer/nope
resid-cmw: no member "nope" in "outer"
[exit 1]
## editing
$ resid-cmw set tree.cmw outer/added raw.cmw -o set.cmw
[exit 0]
$ resid-cmw inspect set.cmw
collection 3 members
  "e": record "application/octet-stream" 0 bytes ind=reference-values|endorsements
  "z": record "application/octet-stream" 3 bytes
  "outer": collection type="tag:example.com,2026:demo" 3 members
    "ev": record "application/eat+cbor" 5 bytes ind=evidence
    "raw": record "application/octet-stream" 3 bytes
    "added": record "application/octet-stream" 3 bytes
[exit 0]
$ resid-cmw set tree.cmw z ev.cmw -o replaced.cmw
[exit 0]
$ resid-cmw inspect replaced.cmw
collection 3 members
  "e": record "application/octet-stream" 0 bytes ind=reference-values|endorsements
  "z": record "application/eat+cbor" 5 bytes ind=evidence
  "outer": collection type="tag:example.com,2026:demo" 2 members
    "ev": record "application/eat+cbor" 5 bytes ind=evidence
    "raw": record "application/octet-stream" 3 bytes
[exit 0]
