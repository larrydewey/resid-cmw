## building
$ resid-cmw wrap application/eat+cbor hello.bin --ind evidence -o ev.cmw
[exit 0]
$ resid-cmw wrap application/octet-stream three.bin -o raw.cmw
[exit 0]
$ resid-cmw wrap application/octet-stream empty.bin --ind endorsements,reference-values -o empty.cmw
[exit 0]
$ resid-cmw wrap text/plain hello.bin --ind 4294967295 -o allbits.cmw
[exit 0]
$ resid-cmw collect --type tag:example.com,2026:demo ev=ev.cmw raw=raw.cmw -o inner.cmw
[exit 0]
$ resid-cmw collect outer=inner.cmw z=raw.cmw e=empty.cmw -o tree.cmw
[exit 0]
$ resid-cmw collect all=allbits.cmw -o allbits-coll.cmw
[exit 0]
## bytes are deterministic
$ xxd -p ev.cmw
83746170706c69636174696f6e2f6561742b63626f724568656c6c6f04
[exit 0]
$ xxd -p tree.cmw
a361658378186170706c69636174696f6e2f6f637465742d73747265616d
4003617a8278186170706c69636174696f6e2f6f637465742d7374726561
6d43010203656f75746572a362657683746170706c69636174696f6e2f65
61742b63626f724568656c6c6f04637261778278186170706c6963617469
6f6e2f6f637465742d73747265616d43010203685f5f636d77635f747819
7461673a6578616d706c652e636f6d2c323032363a64656d6f
