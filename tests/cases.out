collection 3 members
  "e": record "application/octet-stream" 0 bytes ind=reference-values|endorsements
  "z": record "application/octet-stream" 3 bytes
  "outer": collection type="tag:example.com,2026:demo" 1 member
    "ev": record "application/eat+cbor" 5 bytes ind=evidence
[exit 0]
$ resid-cmw remove removed.cmw outer/ev -o x.cmw
resid-cmw: removing "ev" would leave "outer" with no members
[exit 1]
$ resid-cmw remove tree.cmw outer/zzz -o x.cmw
resid-cmw: no member "zzz" in "outer"
[exit 1]
$ ls x.cmw
ls: cannot access 'x.cmw': No such file or directory
[exit 2]
